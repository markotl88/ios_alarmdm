      }
    },
    "Dok slušaš, dodirni dugme za zabelešku u plejeru. Zabeleška se čuva pet sekundi pre trenutne pozicije." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While listening, tap the bookmark button in the player. The bookmark is saved five seconds before your current position."
          }
        }
      }
    },
    "Emisija posvećena poeziji." : {
