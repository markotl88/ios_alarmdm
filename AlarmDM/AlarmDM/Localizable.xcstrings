    "Verzija" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version"
          }
        }
      }
    },
    "Zabeleške, omiljeno, dokle si stigao, preuzete epizode i podešavanja - i ovde i u iCloudu, dakle i na ostalim uređajima. Očisti sve uređaje pre nego što ijedan ponovo pokreneš, inače onaj koji još ima podatke vrati sve u iCloud." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bookmarks, favourites, how far you got, downloads and settings — here and in iCloud, so on your other devices too. Clear every device before starting any of them again, or the one that still has data puts it all back in iCloud."
          }
        }
      }
    },
