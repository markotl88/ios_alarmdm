    "Svi mi emigranti. Svakog dana od 11h" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're all emigrants. Every day from 11 am."
          }
        }
      }
    },
    "Teme o kojima se ćuti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The topics nobody talks about."
          }
        }
      }
    },
    "Trenutno si na mobilnoj mreži. Možeš preuzeti samo ovu epizodu, ili ukloniti ograničenje za ubuduće - kasnije ga vraćaš u Ostalo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're on mobile data. You can download just this episode, or lift the restriction from now on — you can turn it back on under More."
          }
        }
      }
    },
