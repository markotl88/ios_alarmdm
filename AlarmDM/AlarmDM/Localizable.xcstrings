    "Daško i Mlađa od ponedeljka do četvrtka, od 8 do 10 h. Varnju radnim danima od 11 do 14 h. Dobra muzika non-stop!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daško and Mlađa Monday through Thursday, 8 to 10 AM. Varnju Monday through Friday, 11 AM to 2 PM. Great music non-stop!"
