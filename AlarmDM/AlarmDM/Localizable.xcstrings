    "Sa muzikom" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With music"
          }
        }
      }
    },
    "Ovo podešavanje važi samo za preuzimanje epizoda. Radio uživo i epizode možeš slušati i preko mobilne mreže. Ako želiš da preuzmeš epizodu preko mobilne mreže, aplikacija će tražiti potvrdu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This setting only applies to downloads. You can still stream live radio and episodes over cellular data. The app will ask for confirmation before downloading an episode over cellular data."
          }
        }
      }
    },
    "Emisija posvećena panku i hardkoru." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
