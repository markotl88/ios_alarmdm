        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostalo"
          }
        }
      }
    },
    "Slušanje uživo i strimovanje epizoda rade uvek. Ovo se odnosi samo na preuzimanje - kad si na mobilnoj mreži, aplikacija će pitati pre nego što skine epizodu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live radio and streaming always work. This only applies to downloads — on mobile data, the app asks before downloading an episode."
          }
        }
      }
    },
    "Specijalizovana za punk/hardcore zvuk." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedicated to punk and hardcore."
          }
        }
      }
    },
    "Sportska emisija." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
